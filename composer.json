{
    "name": "feedple/feedple-sdk",
    "description": "Official PHP SDK for the Feedple AI platform",
    "type": "library",
    "license": "MIT",
    "keywords": ["feedple", "sdk", "ai", "database", "realtime"],
    "homepage": "https://github.com/UmarBelloKanwa/feedple-sdk",
    "authors": [
        {
            "name": "Umar Bello Kanwa",
            "email": "umarbellokanwa@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.0",
        "monolog/monolog": "^1.25 || ^2.0 || ^3.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "ratchet/pawl": "^0.4",
        "react/event-loop": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5 || ^7.5 || ^8.5 || ^9.5 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Feedple\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Feedple\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
